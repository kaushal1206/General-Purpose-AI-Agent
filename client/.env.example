# Vercel Production Deployment Environment Configuration
# When deploying the frontend to Vercel, set VITE_API_URL to your secure HTTPS tunnel URL
# (e.g., Cloudflare Tunnel: https://your-tunnel.trycloudflare.com or ngrok: https://your-domain.ngrok-free.app)
#
# For local development: Leave blank or omit. Vite dev proxy will automatically forward /api to http://localhost:3001
VITE_API_URL=
