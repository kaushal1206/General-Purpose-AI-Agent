# Server Configuration
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
# Note: Local instance running on port 5434
DATABASE_URL=postgresql://postgres@localhost:5434/agent_db

# Primary Free-First Local AI Model (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Optional Hosted Providers (leave blank to use Ollama exclusively)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Web Search Provider (Optional: Tavily, Brave, SearXNG, or Serper)
SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=

# Email / SMTP Integration (Optional: Real SMTP with mandatory confirmation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Workspace Restrictions for Safe File Operations
WORKSPACE_ROOT=d:/general-purpose AI agent/workspace

# Security & Autonomy Settings
REQUIRE_APPROVAL_FOR_EXTERNAL_SEND=true
REQUIRE_APPROVAL_FOR_FILE_DESTRUCTIVE=true
MAX_EXECUTION_STEPS=10
STEP_TIMEOUT_MS=30000
